# ---------------------------------------------------------------------------
# CODIHA Club, environment variables
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Every PUBLIC_* var is exposed to the browser. The rest are server-only.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon...key"
# Dashboard > Project Settings > API > service_role (SECRET, never expose)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service_role...key"

# --- Site -------------------------------------------------------------------
# Used for OAuth redirects, QR check-in links and certificate verify links.
# No trailing slash. Use http://localhost:5173 while developing.
PUBLIC_SITE_URL="https://club.codiha.com"

# --- Event check-in QR ------------------------------------------------------
# Secret used to HMAC-sign the rotating check-in tokens.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CHECKIN_SECRET="change-me-to-a-long-random-string"
# Token rotation window in seconds (QR changes this often)
CHECKIN_WINDOW_SECONDS="30"

# --- Brevo (transactional email from the admin panel) -----------------------
# Brevo Dashboard > SMTP & API > API Keys > Generate a new API key (v3)
BREVO_API_KEY="xkeysib-...."
# Must be a sender/domain authenticated in Brevo (see README_PLATFORM.md)
BREVO_SENDER_EMAIL="hi@team.codiha.com"
BREVO_SENDER_NAME="CODIHA Club"
BREVO_REPLY_TO="hi@team.codiha.com"

# --- Local tooling only (never add this one to Netlify) ---------------------
# Personal access token: https://supabase.com/dashboard/account/tokens
# Used by scripts/db.mjs to apply the schema and promote admins from the CLI.
# It is account-wide, so keep it out of the deploy environment and the bundle.
SUPABASE_ACCESS_TOKEN="sbp_...."

# --- Club mailboxes (Brevo inbound parse) -----------------------------------
# Brevo requires the RECEIVING domain to differ from the authenticated SENDING
# domain, so member addresses live here and mail goes out from BREVO_SENDER_EMAIL
# with Reply-To pointed back at the member's inbound address.
MAIL_INBOUND_DOMAIN="inbox.codiha.com"
# Brevo does NOT sign its inbound webhook, so this shared secret is the only
# thing protecting /api/mail/inbound. Generate one and append it to the webhook
# URL configured in Brevo:
#   https://club.codiha.com/api/mail/inbound?key=<this value>
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_INBOUND_SECRET=""
